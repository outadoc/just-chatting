<?xml version="1.0" encoding="utf-8"?><!--
    Colours for the static widget previews in res/layout/widget_preview_*.xml.

    The generated previews are rendered by Glance and pick up the system's dynamic palette on their
    own; these keep the static stand-ins looking like the same widget. They are defined against our
    own background rather than the host's theme, so the preview stays legible whatever the launcher
    puts behind it.

    These literals are the pre-Android 12 fallbacks, sampled from a generated preview. Android 12
    and above use the real dynamic palette - see values-v31.
-->
<resources>
    <color name="widget_preview_background">#EEF0FF</color>
    <color name="widget_preview_card">#E1E2ED</color>
    <color name="widget_preview_text">#1B1B1F</color>
    <color name="widget_preview_text_secondary">#45464F</color>
</resources>
